{
  "name": "virtual-electronics-lab",
  "productName": "Virtual Electronics Lab",
  "private": true,
  "version": "1.0.0",
  "description": "Offline virtual electronics laboratory with an oscilloscope, function generator, power supply, multimeters and training boards.",
  "author": "Virtual Electronics Lab",
  "license": "Apache-2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist release server.js .android-build/build2",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/sim/circuitEngine.test.ts",
    "start": "electron .",
    "dist": "vite build && electron-builder --win portable",
    "dist:win": "vite build && electron-builder --win portable",
    "icons": "node scripts/make-icon.cjs",
    "android:sync": "vite build && cap sync android",
    "android:apk": "vite build && bash scripts/build-apk-webview.sh",
    "android:apk:capacitor": "vite build && cap sync android && cd android && gradlew.bat assembleDebug",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.virtuallab.electronics",
    "productName": "Virtual Electronics Lab",
    "copyright": "Copyright © 2026 Virtual Electronics Lab",
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "electron"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/icon.ico",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "artifactName": "Virtual-Electronics-Lab-${version}-portable.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Virtual-Electronics-Lab-${version}-portable.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
